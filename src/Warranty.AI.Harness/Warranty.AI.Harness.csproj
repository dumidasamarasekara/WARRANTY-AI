<Project Sdk="Microsoft.NET.Sdk">

  <!-- Run lifecycle, agents and tools. Talks to models only through the IAiGateway port. -->
  <PropertyGroup>
    <RootNamespace>Warranty.AI.Harness</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Warranty.Application\Warranty.Application.csproj" />
    <ProjectReference Include="..\Warranty.Domain\Warranty.Domain.csproj" />
    <ProjectReference Include="..\Warranty.Guardrails\Warranty.Guardrails.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="JsonSchema.Net" />
  </ItemGroup>

  <ItemGroup>
    <!-- Byte-for-byte copies of specs/001-ai-claim-adjudication/contracts/schemas (a unit test guards against drift). -->
    <EmbeddedResource Include="Schemas\*.schema.json" LogicalName="Warranty.AI.Harness.Schemas.%(Filename)%(Extension)" />
    <!-- The global injection phrase list (research R14), embedded from the knowledge seed so it has one source. -->
    <EmbeddedResource Include="..\..\seed\global\injection-phrases.md" LogicalName="Warranty.AI.Harness.Safety.injection-phrases.md" Link="Safety\injection-phrases.md" />
  </ItemGroup>

</Project>
