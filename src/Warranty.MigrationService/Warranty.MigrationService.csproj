<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!-- One-shot worker: migrate, create roles/RLS, seed tenants and index knowledge, then exit. -->
  <PropertyGroup>
    <RootNamespace>Warranty.MigrationService</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Warranty.ServiceDefaults\Warranty.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Warranty.Infrastructure\Warranty.Infrastructure.csproj" />
    <ProjectReference Include="..\Warranty.Knowledge\Warranty.Knowledge.csproj" />
    <ProjectReference Include="..\Warranty.Integrations.Simulated\Warranty.Integrations.Simulated.csproj" />
    <ProjectReference Include="..\Warranty.AI.Gateway\Warranty.AI.Gateway.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" />
  </ItemGroup>

  <ItemGroup>
    <!-- Byte-for-byte copy of specs/002-remedy-repair-handover/contracts/remedy-rules.schema.json; validates the seed's remedies block. -->
    <EmbeddedResource Include="Seeding\Schemas\*.schema.json" LogicalName="Warranty.MigrationService.Seeding.Schemas.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
