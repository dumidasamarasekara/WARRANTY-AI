<Project Sdk="Microsoft.NET.Sdk">

  <!-- Provider-agnostic AI Gateway; the only project allowed to reference a vendor AI SDK. -->
  <PropertyGroup>
    <RootNamespace>Warranty.AI.Gateway</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Warranty.Application\Warranty.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="OllamaSharp" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="System.Threading.RateLimiting" />
  </ItemGroup>

  <ItemGroup>
    <!-- Versioned system prompts: PromptTemplates/{id}.v{n}.md. -->
    <EmbeddedResource Include="PromptTemplates\*.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Warranty.UnitTests" />
    <InternalsVisibleTo Include="Warranty.IntegrationTests" />
  </ItemGroup>

</Project>
