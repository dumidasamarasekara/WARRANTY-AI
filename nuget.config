<?xml version="1.0" encoding="utf-8"?>
<!-- Repository-local NuGet configuration: one public source, so restores are reproducible on any
     machine and central package management does not warn about unmapped sources (NU1507). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
