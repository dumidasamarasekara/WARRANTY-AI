{
  "permissions": {
    "allow": [
      "PowerShell(dotnet build *)",
      "PowerShell(dotnet test *)",
      "PowerShell(git *)",
      "PowerShell(pwsh -NoProfile -File scripts/git/task-flow.ps1 *)",
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(git *)",
      "Bash(pwsh -NoProfile -File scripts/git/task-flow.ps1 *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "input=$(cat); case \"$input\" in *git*commit*|*git*push*) printf \"%s\" \"$input\" | pwsh -NoProfile -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-commit-on-default-branch.ps1\";; esac",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
