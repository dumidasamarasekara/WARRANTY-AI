<Project Sdk="Microsoft.NET.Sdk">

  <!-- Testcontainers (Postgres + pgvector, Azurite) and WebApplicationFactory against the real API. -->
  <PropertyGroup>
    <RootNamespace>Warranty.IntegrationTests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.Azurite" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Aspire.Hosting.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Warranty.Api\Warranty.Api.csproj" />
    <!-- Aliased: their top-level Program would clash with the API's Program used by WebApplicationFactory. -->
    <ProjectReference Include="..\..\src\Warranty.MigrationService\Warranty.MigrationService.csproj" Aliases="migration" />
    <ProjectReference Include="..\..\src\Warranty.AppHost\Warranty.AppHost.csproj" Aliases="apphost" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

</Project>
