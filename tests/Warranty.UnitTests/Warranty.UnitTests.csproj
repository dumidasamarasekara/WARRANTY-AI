<Project Sdk="Microsoft.NET.Sdk">

  <!-- Fast, I/O-free tests: guardrail rules, domain state machine, harness helpers, architecture. -->
  <PropertyGroup>
    <RootNamespace>Warranty.UnitTests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="NetArchTest.Rules" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Warranty.Domain\Warranty.Domain.csproj" />
    <ProjectReference Include="..\..\src\Warranty.Application\Warranty.Application.csproj" />
    <ProjectReference Include="..\..\src\Warranty.Guardrails\Warranty.Guardrails.csproj" />
    <ProjectReference Include="..\..\src\Warranty.AI.Harness\Warranty.AI.Harness.csproj" />
    <ProjectReference Include="..\..\src\Warranty.AI.Gateway\Warranty.AI.Gateway.csproj" />
    <ProjectReference Include="..\..\src\Warranty.Knowledge\Warranty.Knowledge.csproj" />
    <ProjectReference Include="..\..\src\Warranty.Infrastructure\Warranty.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Warranty.Integrations.Simulated\Warranty.Integrations.Simulated.csproj" />
    <ProjectReference Include="..\..\src\Warranty.Api\Warranty.Api.csproj" />
    <ProjectReference Include="..\..\src\Warranty.MigrationService\Warranty.MigrationService.csproj" />
    <!-- Metric calculations of the golden-set evaluation runner (pure functions; unit tests never run the runner). -->
    <ProjectReference Include="..\Warranty.Evaluation\Warranty.Evaluation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Shouldly" />
  </ItemGroup>

</Project>
